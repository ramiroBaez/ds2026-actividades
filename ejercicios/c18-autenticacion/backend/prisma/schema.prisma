generator client {
  provider = "prisma-client" // Prisma 7. NO "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // sin url: en Prisma 7 va en prisma.config.ts
}

enum Rol {
  ADMIN
  CLIENTE
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(CLIENTE)
  creadoEn     DateTime @default(now())
}

model Libro {
  id          Int        @id @default(autoincrement())
  titulo      String
  imagen      String
  descripcion String
  precio      Int
  disponible  Boolean    @default(true)
  autorId     Int
  autor       Autor      @relation(fields: [autorId], references: [id])
  categorias  Categoria[]
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique
  nacionalidad String
  biografia    String
  libros       Libro[]
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}